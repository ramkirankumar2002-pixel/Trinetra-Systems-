  STARTUP
}

enum WeightAnomalyType {
  EMPTY_PLATFORM_WEIGHT
  SUDDEN_WEIGHT_CHANGE
  REPEATED_INSTABILITY
  WEIGHT_JUMP
  NEGATIVE_OR_INVALID_WEIGHT
}

