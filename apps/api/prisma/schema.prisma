generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TransactionStatus {
  ARRIVED
  IDENTIFIED
  DOCUMENT_PENDING
  DOCUMENT_VERIFIED
  MATERIAL_CLASSIFIED
  FIRST_WEIGHMENT
  PENDING_APPROVAL
  APPROVED
  UNLOADING
  UNLOADED
  SECOND_WEIGHMENT
  COMPLETED
  ON_HOLD
  REJECTED
  CANCELLED
  EXCEPTION
}

enum WeighmentKind {
  GROSS
  TARE
  OTHER
}

enum WeighmentSource {
  MANUAL
  SIMULATED
  HARDWARE
}

enum WeighbridgeProviderType {
  SIMULATOR
  SERIAL
  TCP
  MODBUS_RTU
  MODBUS_TCP
}

enum HardwareDeviceStatus {
  CONNECTED
  DISCONNECTED
  CONNECTING
  ERROR
  DISABLED
}

enum WeightQuality {
  STABLE
  UNSTABLE
  INVALID
  NO_DATA
  DEVICE_ERROR
}

enum CameraPurpose {
  ENTRY_ANPR
  EXIT_ANPR
  GENERAL_MONITORING
}

enum CameraConnectionType {
  SIMULATOR
  RTSP
  HTTP_SNAPSHOT
  LOCAL
}

enum CameraProviderType {
  SIMULATOR
  RTSP
  HTTP_SNAPSHOT
  LOCAL
}

enum AnprProviderType {
  SIMULATOR
}

enum AnprProviderStatus {
  READY
  PROCESSING
  ERROR
  UNAVAILABLE
}

enum AnprDetectionLifecycle {
