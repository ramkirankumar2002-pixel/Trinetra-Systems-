enum SecuritySeverity {
  ANOMALY
  SUSPICIOUS_EVENT
  HIGH_RISK_EVENT
}

enum SecurityCategory {
  WEIGHT_ANOMALY
  ACCESS
  TAMPER_SUSPICION
  PERSON_DETECTION
