# Copy this file to .env in the same folder before running the API.
# Never commit a real .env file. Replace placeholders with local values.

NODE_ENV=development
PORT=4000

# Browser origin allowed to call this API. Must match the Vite dev URL.
# Comma-separated origins are allowed. Do not use * in production.
CORS_ORIGIN=http://localhost:5173

# Set true only behind a trusted reverse proxy so rate limits see the client IP.
TRUST_PROXY=false

# PostgreSQL connection string. Required for Prisma migrate, seed, and login.
# The API health endpoint still starts without a database connection.
# Replace USER, PASSWORD, host, port, and database name with your local values.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/trinetra

# Long random string used to sign session JWTs. Never put this in frontend code.
JWT_SECRET=replace-with-a-long-random-string

# Session lifetime. Cookie and server session use this window (max 7 days in production).
JWT_EXPIRES_IN=8h
AUTH_COOKIE_NAME=trinetra_session

# Optional dedicated key for encrypting stored webhook secrets. If empty, JWT_SECRET is used.
# Rotating JWT_SECRET without this key makes existing webhook secrets unreadable.
# INTEGRATION_ENCRYPTION_KEY=

# Demo seed is blocked when NODE_ENV=production unless this is true on an isolated demo database.
# ALLOW_DEMO_SEED=false

# Login rate limit: max attempts per email+IP in the window.
# Defaults: 10 attempts per 15 minutes.
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# Vehicle registration length after normalization (letters/digits only).
VEHICLE_REG_MIN_LENGTH=4
VEHICLE_REG_MAX_LENGTH=15

# First weighment limits in kilograms. Adjust per site equipment later.
WEIGHMENT_MIN_KG=50
WEIGHMENT_MAX_KG=120000

# Optional fixed simulated weight. If empty, the simulator varies the reading.
# WEIGHMENT_SIMULATED_KG=35000

# Comma-separated plates used by the simulated ANPR provider.
ANPR_SIMULATED_PLATES=AP39XX1234,MH12AB1234,TS09EA1234

# Configurable ANPR confidence bands. Not an industrial standard.
ANPR_HIGH_CONFIDENCE_MIN=0.9
ANPR_MEDIUM_CONFIDENCE_MIN=0.7
ANPR_FAILURE_ALERT_THRESHOLD=3
ANPR_EVIDENCE_RETENTION_DAYS=30
ANPR_EVIDENCE_STORAGE_DIR=storage/anpr-evidence

# Document uploads. Storage stays outside source folders. Types are configurable.
DOCUMENT_MAX_BYTES=10485760
DOCUMENT_STORAGE_DIR=storage/documents
DOCUMENT_TYPES=INVOICE,DELIVERY_CHALLAN,PURCHASE_DOCUMENT,GATE_PASS,OTHER

# Material master units and OCR auto-match threshold (0-1). Below this, material needs review.
MATERIAL_UNITS=KG,TON,MT,LITRE,PIECE
MATERIAL_OCR_MIN_CONFIDENCE=0.9

# Driver / operator mode. Voice and audio stay local or simulated; no paid providers.
DRIVER_MODE_ENABLED=true
DRIVER_DEFAULT_LANGUAGE=en
DRIVER_LANGUAGES=en,hi,te
DRIVER_VOICE_ENABLED=true
DRIVER_AUDIO_ENABLED=true

# Edge Gateway heartbeat timeout. Temporary network loss is not treated as hardware failure.
GATEWAY_OFFLINE_TIMEOUT_MS=45000
GATEWAY_STALE_AFTER_MS=20000
EDGE_INGEST_MAX_BYTES=12582912
# Development-only simulator credential. Must match apps/edge/.env.example. Never use in production.
# EDGE_GATEWAY_DEV_SECRET=tgw_devonly_trinetra_edge_simulator_not_for_production_0001

# Optional pg_dump-based backup. Disabled by default. Requires pg_dump on PATH and a writable directory.
# This is not a substitute for operator-managed WAL/PITR backups in production.
BACKUP_ENABLED=false
BACKUP_DIRECTORY=storage/backups
BACKUP_RETENTION_DAYS=14
# 0 disables the in-process scheduler. Example 86400000 = 24 hours.
BACKUP_INTERVAL_MS=0

# Stale transaction warnings. Transactions are never auto-cancelled.
RELIABILITY_SCAN_INTERVAL_MS=300000
STALE_DOCUMENT_PENDING_HOURS=4
STALE_PENDING_APPROVAL_HOURS=8
STALE_UNLOADING_HOURS=6
STALE_SECOND_WEIGHMENT_HOURS=4
STALE_INTERMEDIATE_HOURS=12

# Development-only failure simulation. Ignored when NODE_ENV=production.
SIMULATE_DATABASE_UNAVAILABLE=false
SIMULATE_EDGE_OFFLINE=false
SIMULATE_SYNC_FAILURE=false
SIMULATE_PROVIDER_UNAVAILABLE=false

# Observability. In-memory metrics are not production historical monitoring.
LOG_LEVEL=info
SLOW_REQUEST_MS=2000
SLOW_QUERY_MS=500
MONITORING_API_ERROR_RATE=0.2
MONITORING_MIN_SAMPLE_SIZE=20
MONITORING_SYNC_QUEUE_WARN=100
MONITORING_FAILED_SYNC_WARN=10
MONITORING_DB_LATENCY_MS=500

# Integration webhook delivery. Failed deliveries never roll back transactions.
# Defaults: 10s timeout, 5s worker interval. Private/loopback webhook URLs are allowed outside production.
INTEGRATION_WEBHOOK_TIMEOUT_MS=10000
INTEGRATION_DELIVERY_INTERVAL_MS=5000
